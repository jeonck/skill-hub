---
title: {{SITE_TITLE}}
layout: hextra-home
---

{{</* hextra/hero-badge */>}}
  <div class="hx:w-2 hx:h-2 hx:rounded-full hx:bg-primary-400"></div>
  <span>{{HERO_BADGE_TEXT}}</span>
  {{</* icon name="arrow-circle-right" attributes="height=14" */>}}
{{</* /hextra/hero-badge */>}}

<div class="hx:mt-6 hx:mb-6">
{{</* hextra/hero-headline */>}}
  {{HERO_HEADLINE}}
{{</* /hextra/hero-headline */>}}
</div>

<div class="hx:mb-12">
{{</* hextra/hero-subtitle */>}}
  {{HERO_SUBTITLE}}
{{</* /hextra/hero-subtitle */>}}
</div>

<div class="hx:mb-6">
{{</* hextra/hero-button text="{{CTA_TEXT}}" link="docs" */>}}
</div>

{{</* hextra/feature-grid */>}}
  {{</* hextra/feature-card
    title="① {{CATEGORY_1_TITLE}}"
    subtitle="{{CATEGORY_1_SUBTITLE}}"
    link="docs/{{CATEGORY_1_SLUG}}"
    icon="{{CATEGORY_1_ICON}}"
  */>}}
  {{</* hextra/feature-card
    title="② {{CATEGORY_2_TITLE}}"
    subtitle="{{CATEGORY_2_SUBTITLE}}"
    link="docs/{{CATEGORY_2_SLUG}}"
    icon="{{CATEGORY_2_ICON}}"
  */>}}
  {{/* ... repeat one hextra/feature-card block per docs category, numbered ①②③④⑤⑥... */}}
{{</* /hextra/feature-grid */>}}
